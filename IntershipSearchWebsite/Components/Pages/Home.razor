@page "/"
@rendermode InteractiveServer 
@implements IDisposable
@inject InternshipSearchService SearchService

<PageTitle>Internship Search</PageTitle>

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h1 class="fw-bolder">Find Your Summer 2027 Internship</h1>
        <p class="text-muted">Browse the latest software engineering, data, and tech roles.</p>
    </div>

    <!-- Search Bar -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-8">
            <div class="input-group input-group-lg shadow-sm">
                <input type="text" 
                       class="form-control border-0" 
                       placeholder="Search by role, company, or location..." 
                       @bind="searchText" 
                       @bind:event="oninput" 
                       @onkeyup="PerformSearch" />
                <button class="btn btn-primary px-4" @onclick="PerformSearch">
                    Search
                </button>
            </div>
        </div>
    </div>

    <!-- Results Grid -->
    <div class="row g-4">
        @if (results == null)
        {
            <div class="col-12 text-center mt-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted">Fetching latest jobs...</p>
            </div>
        }
        else if (results.Count == 0)
        {
            <div class="col-12">
                <div class="alert alert-warning text-center shadow-sm border-0">
                    No internships found matching "<strong>@searchText</strong>"
                </div>
            </div>
        }
        else
        {
            @foreach (var job in results)
            {
                <div class="col-12 col-lg-6">
                    <div class="card h-100 shadow-sm border-0 job-card">
                        <div class="card-body p-4">
                            
                            <!-- Badges Row -->
                            <div class="d-flex gap-2 mb-2">
                                @if (job.IsRemote)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Remote</span>
                                }
                                @if (job.AdvancedDegreeRequired)
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25">Advanced Degree Required</span>
                                }
                                @if (job.Tags != null)
                                {
                                    @foreach (var tag in job.Tags)
                                    {
                                        <span class="badge bg-light text-dark border">@tag</span>
                                    }
                                }
                            </div>

                            <!-- Title & Company -->
                            <h4 class="card-title fw-bold mb-1">@job.Title</h4>
                            <h6 class="card-subtitle mb-3 text-primary fw-semibold">
                                @job.Company
                            </h6>
                            
                            <!-- Location -->
                            <div class="text-muted small mb-3">
                                @job.Location
                            </div>
                            
                            <!-- Description -->
                            @if (!string.IsNullOrWhiteSpace(job.Description))
                            {
                                <p class="card-text text-secondary small">@job.Description</p>
                            }
                        </div>

                        <!-- Action Footer -->
                        <div class="card-footer bg-transparent border-0 p-4 pt-0 d-flex justify-content-end">
                            @if (job.Url == "Closed")
                            {
                                <button class="btn btn-secondary disabled w-100 fw-bold" style="max-width: 150px;">
                                    Closed
                                </button>
                            }
                            else
                            {
                                <a href="@job.Url" target="_blank" class="btn btn-primary fw-bold w-100 shadow-sm" style="max-width: 150px;">
                                    Apply Now &rarr;
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .job-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .job-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>

@code {
    private string searchText = string.Empty;
    private List<InternshipPosting>? results;

    protected override async Task OnInitializedAsync()
    {
        SearchService.OnDataUpdated += HandleDataUpdate;
        await PerformSearch(); 
    }

    private async void HandleDataUpdate()
    {
        await PerformSearch();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PerformSearch()
    {
        results = await SearchService.SearchAsync(searchText);
    }

    public void Dispose()
    {
        SearchService.OnDataUpdated -= HandleDataUpdate;
    }
}