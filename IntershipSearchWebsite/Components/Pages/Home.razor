@page "/"
@rendermode InteractiveServer 
@implements IDisposable
@inject InternshipSearchService SearchService

<PageTitle>Internship Search</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4">Find Your Internship</h1>

    <div class="row mb-4">
        <div class="col-md-8 mb-2">

            <input type="text" 
                   class="form-control form-control-lg" 
                   placeholder="Search by role, company, or keyword (e.g., C#, Data)..." 
                   @bind="searchText" 
                   @bind:event="oninput" 
                   @onkeyup="PerformSearch" />
        </div>
        <div class="col-md-4">
            <button class="btn btn-primary btn-lg w-100" @onclick="PerformSearch">
                Search
            </button>
        </div>
    </div>

    <!-- Results Grid -->
    <div class="row g-4">
        @if (results == null)
        {
            <p><em>Loading...</em></p>
        }
        else if (results.Count == 0)
        {
            <div class="alert alert-warning">No internships found matching "@searchText".</div>
        }
        else
        {
            @foreach (var job in results)
            {
                <div class="col-12 col-md-6">
                    <div class="card h-100 shadow-sm border-0 bg-light">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title text-primary fw-bold mb-0">@job.Title</h5>
                                @if (job.IsRemote)
                                {
                                    <span class="badge bg-success">Remote</span>
                                }
                            </div>
                            
                            <h6 class="card-subtitle mb-3 text-muted">
                                @job.Company &bull; @job.Location
                            </h6>
                            
                            <p class="card-text">@job.Description</p>
                            
                            <div class="mb-3">
                                @foreach (var tag in job.Tags)
                                {
                                    <span class="badge bg-white text-dark border me-1">@tag</span>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-white text-danger fw-bold border-top-0">
                            Deadline: @job.Deadline?.ToString("MMMM dd, yyyy")
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private string searchText = string.Empty;
    private List<InternshipPosting>? results;

    protected override async Task OnInitializedAsync()
    {
        SearchService.OnDataUpdated += HandleDataUpdate;

        await PerformSearch(); 
    
    }

    private async void HandleDataUpdate()
    {
        await PerformSearch();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PerformSearch()
    {
        // Ask the service to filter the mock data based on the user's text
        results = await SearchService.SearchAsync(searchText);
    }

    public void Dispose()
    {
        SearchService.OnDataUpdated -= HandleDataUpdate;
    }
}